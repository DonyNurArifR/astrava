# ASTRAVA Environment Configuration

# Application
APP_NAME=ASTRAVA
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# Brand & General
BRAND_TAGLINE="From vision to execution."

# Database
DATABASE_URL=postgresql+asyncpg://astrava:astrava_dev_password@localhost:5432/astrava
DATABASE_URL_SYNC=postgresql://astrava:astrava_dev_password@localhost:5432/astrava

# Storage
ARTIFACT_STORAGE_PATH=./storage/artifacts

# AI Providers & Model Execution
CLAUDE_CLI_PATH=claude
DEFAULT_CLAUDE_MODEL=haiku
CLAUDE_EXECUTION_TIMEOUT_SECONDS=180
MAX_CONCURRENT_EXECUTIONS=1

# Human Approvals
REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true
REQUIRE_APPROVAL_FOR_DEPLOYMENT=true
