# ASTRAVA Environment Configuration

# Application
APP_NAME=ASTRAVA
APP_ENV=development
APP_PORT=8000
# Bind to loopback by default. Non-loopback requires OPERATOR_API_KEY and DEBUG=false.
APP_HOST=127.0.0.1
DEBUG=false

# Operator authentication (M1.5-1a). See docs/SECURITY.md.
# LEAVE UNSET for local development on loopback (do not set it to an empty value).
# Required (>= 32 chars) for any non-loopback APP_HOST. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# OPERATOR_API_KEY=
# Hostnames the API will answer to (port ignored). Add your public hostname when deploying.
# ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","::1"]
# Directories under which a project's git repository may live (JSON list of absolute paths).
# Empty = repositories are rejected (fail closed). Example:
# ALLOWED_REPO_ROOTS=["/Users/you/code"]
# SESSION_TTL_SECONDS=28800
# COOKIE_SECURE=true

# Brand & General
BRAND_TAGLINE="From vision to execution."

# Database
DATABASE_URL=postgresql+asyncpg://astrava:astrava_dev_password@localhost:5433/astrava
DATABASE_URL_SYNC=postgresql://astrava:astrava_dev_password@localhost:5433/astrava

# Storage
ARTIFACT_STORAGE_PATH=./storage/artifacts

# AI Providers & Model Execution
CLAUDE_CLI_PATH=claude
DEFAULT_CLAUDE_MODEL=haiku
CLAUDE_EXECUTION_TIMEOUT_SECONDS=180
MAX_CONCURRENT_EXECUTIONS=1

# Human Approvals
REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true
REQUIRE_APPROVAL_FOR_DEPLOYMENT=true
